	p68h11

* Cosas para testear:

	ORG	$2000

	inc	$10
	ldaa	$10
	ldaa	$100
	ldaa	255
	ldaa	256
	ldaa	-1

label1			
*			$2000
label2	EQU	*+4	$2004
label3	ldaa	#3	$2000
label35	FCB	2,3,4	$2002
label4	RMB	4	$2005
label5	ORG	*+4	$200D

labelA	ORG	$ABCD0000
l____A	EQU	.HWRD.labelA
	ldaa	#2
l___AA	EQU	.HWRD.*


*	ORG	2,x
*	ldaa	#2,2,2

*	FCC	'Testing_''strings'''

* NOTA: LE QUITE TODOS LOS SETS Y MACROS A ESTE ARCHIVO. NO COMPILARA, PERO AL MENOS PODRÁ PASAR POR EL PRECOMPILADOR


HEIGHT	EQU	128
WIDTH	EQU	128
STKSIZE	EQU	256
DSPSIZE	EQU	HEIGHT*WIDTH

DISPLAY	EQU	$2000	- $5FFF
DISPEND	EQU	DISPLAY+DSPSIZE = $6000
CODE	EQU	$C000	- $DFFF ??? (incluye stack)	D11???
*			- $FFBF
*
*	256 puntos de 3 componentes (4 por simplicidad)		X,Y,Z
*	= 1024 bytes ($400)
*	512 aristas de 3 componentes (4 por simplicidad)	from,to,color
*	= 2048 bytes ($800)
EDGES	EQU	$E000	- $E7FF
VERTEX	EQU	$E800	- $EBFF
VERT_T	EQU	$EC00	- $EFFF
META	EQU	$F000	- ??? (max $FFBF)

DISP_H	EQU	$100
DISP_W	EQU	$101
DISP_M	EQU	$102
DISP_D	EQU	$103	- $104
PORTA	EQU	$1000


EDGNUM	EQU	512
EDGSIZE	EQU	4
EDG_FRM	EQU	0
EDG_TO	EQU	1
EDG_COL	EQU	2

VTXNUM	EQU	256
VTXSIZE	EQU	4
VTX_X	EQU	0
VTX_Y	EQU	1
VTX_Z	EQU	2




*****************************************************************
*///////////////////////////////////////////////////////////////*
*****************************************************************
*///////////////////////////////////////////////////////////////*
*****************************************************************
*///////////////////////////////////////////////////////////////*
*****************************************************************



********
* main *
********

	ORG	CODE
main	EQU	*
	lds	#stk_in
	jsr	init_config
	
start	EQU	*

	ldaa	#$0
	psha
	jsr	clear_screen
	pula
	
	jsr	transform_vertexes
	
	ldx	#EDGES
edgloop	EQU	*
	ldaa	EDG_COL,x
	psha

	ldaa	EDG_TO,x
	ldab	#EDGSIZE
	mul
	addd	#VERT_T
	xgdy
	ldaa	VTX_Y,y
	psha
	ldaa	VTX_X,y
	psha
	
	ldaa	EDG_FRM,x
	ldab	#EDGSIZE
	mul
	addd	#VERT_T
	xgdy
	ldaa	VTX_Y,y
	psha
	ldaa	VTX_X,y
	psha

	jsr	line_drawer

	pula
	pula
	pula
	pula
	pula
	
	xgdx
	addd	#EDGSIZE
	xgdx
	cpx	edges_end
	bne	edgloop
	
	bra	start
fin	bra	fin


