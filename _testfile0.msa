*****************************************************************


	ORG	EDGES
	FCB	0,1,COLOR,0
	FCB	1,2,COLOR,0
	FCB	2,3,COLOR,0
	FCB	3,4,COLOR,0
	FCB	4,5,COLOR,0
	FCB	5,6,COLOR,0
	FCB	6,7,COLOR,0
	FCB	7,0,COLOR,0

	FCB	0+8,1+8,COLOR,0
	FCB	1+8,2+8,COLOR,0
	FCB	2+8,3+8,COLOR,0
	FCB	3+8,4+8,COLOR,0
	FCB	4+8,5+8,COLOR,0
	FCB	5+8,0+8,COLOR,0

	FCB	0+14,1+14,COLOR,0
	FCB	1+14,2+14,COLOR,0
	FCB	2+14,3+14,COLOR,0
	FCB	3+14,4+14,COLOR,0
	FCB	4+14,5+14,COLOR,0
	FCB	5+14,0+14,COLOR,0

	FCB	0,0+8,COLOR,0
	FCB	0,0+14,COLOR,0
	FCB	1,1+8,COLOR,0
	FCB	1,1+14,COLOR,0
	FCB	2,1+8,COLOR,0
	FCB	2,1+14,COLOR,0
