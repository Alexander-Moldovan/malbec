	FCB	6,5+8,COLOR,0
	FCB	6,5+14,COLOR,0
	FCB	7,5+8,COLOR,0
	FCB	7,5+14,COLOR,0

EDGES_END	EQU	*
	
	ORG	VERTEX
	FCB	0,-32,0,0
	FCB	32,-48,0,0
	FCB	64,-24,0,0
	FCB	64,24,0,0
	FCB	0,64,0,0
	FCB	-64,24,0,0
	FCB	-64,-24,0,0
	FCB	-32,-48,0,0

	FCB	0,0,32,0
	FCB	32,-16,32,0
	FCB	32,16,32,0
	FCB	0,32,32,0
	FCB	-32,16,32,0
	FCB	-32,-16,32,0

	FCB	0,0,-32,0
	FCB	32,-16,-32,0
	FCB	32,16,-32,0
	FCB	0,32,-32,0
	FCB	-32,16,-32,0
	FCB	-32,-16,-32,0


VERTEX_END	EQU	*
VERT_T_END	EQU	VERT_T+(VERTEX_END-VERTEX)

	ORG	META
edges_end	FDB	EDGES_END	*EDGES+(edges_defined*EDGSIZE)
vertex_end	FDB	VERTEX_END	*VERTEX+(vertex_defined*VTXSIZE)
vert_t_end	FDB	VERT_T_END	*VERT_T+(vertex_defined*VTXSIZE)

*edges_defined = 12
*vertex_defined = 8
	
rot_x	FCB	0
rot_y	FCB	0
rot_z	FCB	0
	

	END
