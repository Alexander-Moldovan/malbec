*///////////////////////////////////////////////////////////////*
*****************************************************************
*///////////////////////////////////////////////////////////////*
*****************************************************************


*****************************************************************
*	**********************					*
*	* transform_vertexes *					*
*	**********************					*
*								*
*	Recibe: Nada						*
*								*
*	Estructura stack					*
*								*
* FP ->	|     AccA	|					*
*	|     AccB	|					*
*	|     IX (H)	|					*
*	|     IX (L)	|					*
*	|     IY (H)	|					*
*	|     IY (L)	|					*
*	|     PC (H)	|					*
*	|     PC (L)	|					*
*								*
*	Entrega: Nada						*
*								*
*	Funcion:						*
*	Transforma todos los vertices de la lista VERTEX a	*
*	VERT_T, aplicando rotaciones, zoom y translaciones	*
*								*
*****************************************************************

transform_vertexes	EQU	*
	
* Copia de los datos sin modificar
	ldx	#VERTEX
	ldy	#VERT_T
	
copyver	EQU	*
	ldaa	VTX_X,x
	staa	VTX_X,y
	ldaa	VTX_Y,x
	staa	VTX_Y,y
	ldaa	VTX_Z,x
	staa	VTX_Z,y

	ldab	#VTXSIZE
	abx
	aby
	cpx	vertex_end
	bne	copyver

* Transformar los vertices en VERT_T
	tsy
	ldx	#VERT_T
	
transf_single_vtx	EQU	*
	ldaa	rot_z
	psha
	ldaa	VTX_Y,x
	psha
	ldaa	VTX_X,x
	psha
	jsr	rotate
	pula
	staa	VTX_X,x
	pula
	staa	VTX_Y,x
	pula
	
	ldaa	rot_x
	psha
	ldaa	VTX_Z,x
	psha
	ldaa	VTX_Y,x
	psha
	jsr	rotate
	pula
	staa	VTX_Y,x
	pula
	staa	VTX_Z,x
	pula
	
	ldaa	rot_y
	psha
	ldaa	VTX_X,x
	psha
	ldaa	VTX_Z,x
	psha
	jsr	rotate
	pula
	staa	VTX_Z,x
	pula
	staa	VTX_X,x
	pula
	
	ldab	#VTXSIZE
	abx
	cpx	vert_t_end
	bne	transf_single_vtx
	

	rts


